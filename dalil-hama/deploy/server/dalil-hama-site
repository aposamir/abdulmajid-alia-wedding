#!/usr/bin/env bash
# دليل حماة — تشغيل الموقع الجديد على سيرفر majid.cfd خلف Caddy، مع تحديث تلقائي ورجوع فوري.
#
# أول مرة، على السيرفر:
#   curl -fsSL <رابط هذا الملف> -o /tmp/dalil-hama-site && sudo bash /tmp/dalil-hama-site install
#
# بعد التثبيت:
#   sudo dalil-hama-site status     حالة الموقع والتحديث
#   sudo dalil-hama-site update     جلب آخر إصدار الآن (يجري تلقائياً كل 10 دقائق)
#   sudo dalil-hama-site previous   الرجوع إلى الإصدار السابق وإيقاف التحديث التلقائي
#   sudo dalil-hama-site resume     استئناف التحديث التلقائي
#   sudo dalil-hama-site rollback   إعادة النطاق إلى الموقع القديم فوراً
#
# لا يمس هذا الأمر الموقعَ القديم (خدمة dalil-hama وقاعدة بياناتها) ولا مواقع Caddy الأخرى:
# يستبدل كتلة dalil-hama.majid.cfd وحدها بسطر import، ويحفظ نسخة منها لإعادتها عند الرجوع.
set -Eeuo pipefail
umask 022

HOST=${DH_HOST:-dalil-hama.majid.cfd}
REPO=${DH_REPO:-aposamir/abdulmajid-alia-wedding}
BRANCH=${DH_BRANCH:-claude/dalil-hama-rebuild-tvy38e}
SUBDIR=dalil-hama/public
BASE=${DH_BASE:-/var/www/dalil-hama}
STATE=${DH_STATE:-/var/lib/dalil-hama-site}
ETC=${DH_ETC:-/etc/dalil-hama-site}
CONF=$ETC/config
SITE_CONF=$ETC/site.caddy
CADDYFILE=${DH_CADDYFILE:-}
SELF_DST=${DH_SELF_DST:-/usr/local/sbin/dalil-hama-site}
UNIT_DIR=${DH_UNIT_DIR:-/etc/systemd/system}
UNIT=dalil-hama-site-update
SITE_USER=${DH_SITE_USER:-dalil-site}
KEEP=5
PORT=${DH_VERIFY_PORT:-443}
read -r -a VERIFY_OPTS <<< "${DH_VERIFY_CURL_OPTS:-}"
MARKER='# dalil-hama-site: الموقع الجديد لدليل حماة. للرجوع إلى القديم: sudo dalil-hama-site rollback'
QUIET=0
TMP=

cleanup() { [ -n "$TMP" ] && rm -rf -- "$TMP"; return 0; }
trap cleanup EXIT

say()  { [ "$QUIET" = 1 ] || printf '%s\n' "$*" || true; }
ok()   { say "✓ $*"; }
warn() { printf '! %s\n' "$*" >&2 || true; }
die()  {
  # أخطاء التحديث التلقائي تُحفظ ليعرضها أمر status
  if [ -n "${ERRLOG:-}" ]; then printf '%s  %s\n' "$(date -u +%FT%TZ)" "$*" > "$ERRLOG" 2>/dev/null || true; fi
  printf '✗ %s\n' "$*" >&2 || true
  exit 1
}

need_root() { [ "$(id -u)" -eq 0 ] || die "شغّل الأمر بصلاحية الجذر: sudo $0 $*"; }

need_tools() {
  local t
  for t in "$@"; do command -v "$t" >/dev/null 2>&1 || die "الأداة $t غير مثبّتة على السيرفر"; done
}

is_sha() { [[ ${1:-} =~ ^[0-9a-f]{40}$ ]]; }

# إعدادات اختيارية في $CONF بصيغة KEY=VALUE (REPO وBRANCH فقط)، تُقرأ ولا تُنفَّذ
load_conf() {
  [ -r "$CONF" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(REPO|BRANCH)[[:space:]]*=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]%%[[:space:]]#*}
    val=$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e "s/^[\"']//" -e "s/[\"']\$//")
    case $key in
      REPO)
        if [[ $val =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then [ -n "${DH_REPO:-}" ] || REPO=$val
        else warn "تجاهلت السطر REPO=$val في $CONF"; fi ;;
      BRANCH)
        if [[ $val =~ ^[A-Za-z0-9._/-]+$ ]]; then [ -n "${DH_BRANCH:-}" ] || BRANCH=$val
        else warn "تجاهلت السطر BRANCH=$val في $CONF"; fi ;;
    esac
  done < "$CONF"
  return 0
}

take_lock() {
  mkdir -p "$BASE"
  exec 9>>"$BASE/.lock"
  flock -w 300 9 || die "عملية أخرى للموقع قيد التنفيذ؛ أعد المحاولة بعد قليل"
}

remote_sha() {
  local out=
  if [ -n "${DH_SOURCE_SHA:-}" ]; then out=$DH_SOURCE_SHA
  else
    if command -v git >/dev/null 2>&1; then
      out=$(GIT_TERMINAL_PROMPT=0 timeout 60 git ls-remote "https://github.com/$REPO.git" "refs/heads/$BRANCH" 2>/dev/null | awk 'NR==1{print $1}') || out=
    fi
    if ! is_sha "$out"; then
      out=$(curl -fsSL --connect-timeout 20 --max-time 60 -H 'Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$REPO/commits/$BRANCH" 2>/dev/null) || out=
    fi
  fi
  is_sha "$out" || return 1
  printf '%s\n' "$out"
}

current_sha() {
  local t
  t=$(readlink "$BASE/current" 2>/dev/null) || return 1
  t=${t##*/}
  is_sha "$t" || return 1
  printf '%s\n' "$t"
}

# الإصدار الذي يعرضه Caddy فعلاً: من السيرفر نفسه أولاً (دون أي وكيل)، ثم عبر العنوان العام
# إن تعذّر الاتصال المحلي. ردّ HTTP بخطأ (404 من الموقع القديم مثلاً) يعني أن الموقع الجديد غير معروض.
served_sha() {
  local out rc url="https://$HOST:$PORT/release.txt"
  out=$(curl -fsS --noproxy '*' --connect-timeout 3 --max-time 6 ${VERIFY_OPTS[@]+"${VERIFY_OPTS[@]}"} \
          -H 'Cache-Control: no-cache' --resolve "$HOST:$PORT:127.0.0.1" "$url" 2>/dev/null) && rc=0 || rc=$?
  if [ "$rc" -ne 0 ]; then
    [ "$rc" -eq 22 ] && return 1
    out=$(curl -fsS --connect-timeout 5 --max-time 8 ${VERIFY_OPTS[@]+"${VERIFY_OPTS[@]}"} \
            -H 'Cache-Control: no-cache' "$url" 2>/dev/null) || return 1
  fi
  out=${out//[$'\r\n\t ']/}
  is_sha "$out" || return 1
  printf '%s\n' "$out"
}

wait_served() {
  local until=$((SECONDS + 30))
  while [ "$SECONDS" -lt "$until" ]; do
    [ "$(served_sha || true)" = "$1" ] && return 0
    sleep 1
  done
  return 1
}

# إصدار مرفوض يُعلَّم فلا يُعاد تنزيله كل 10 دقائق ما دام رأس الفرع لم يتغير
reject_release() {
  printf '%s\n' "$2" > "$BASE/bad-$1" 2>/dev/null || true
  die "الإصدار ${1:0:7} مرفوض: $2؛ الموقع باقٍ على الإصدار الحالي"
}

# صفحات فيها <script> مضمَّن (غير JSON): سياسة أمان المحتوى على السيرفر تمنع تشغيله
inline_scripts() {
  python3 - "$1" <<'PY'
import os, re, sys
root, bad = sys.argv[1], []
for d, _, fs in os.walk(root):
    for f in fs:
        if not f.endswith('.html'): continue
        p = os.path.join(d, f)
        for a in re.findall(r'<script\b([^>]*)>', open(p, encoding='utf-8', errors='replace').read(), re.I):
            if re.search(r'\bsrc\s*=', a, re.I) or re.search(r'type\s*=\s*["\']?application/(ld\+)?json', a, re.I):
                continue
            bad.append(os.path.relpath(p, root)); break
print(' '.join(sorted(bad)))
PY
}

# بصمة محتوى الإصدار (دون release.txt)، لتمييز الإصدارات التي لم تغيّر ملفات الموقع
release_digest() {
  (cd "$1" && find . -type f ! -name release.txt -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum) |
    sha256sum | cut -c1-64
}

# ينزّل الإصدار ويتحقق منه في مجلد مؤقت، ثم ينقله دفعة واحدة إلى releases/<sha>
fetch_release() {
  local sha=$1 dir=$BASE/releases/$1 f bad
  [ -d "$dir" ] && return 0
  mkdir -p "$BASE/releases"
  # بقايا تنزيل انقطع (إعادة تشغيل أو إيقاف قسري)؛ القفل بأيدينا فلا تنزيل آخر جارٍ
  rm -rf -- "$BASE"/.tmp.*
  TMP=$(mktemp -d "$BASE/.tmp.XXXXXX")
  if [ -n "${DH_SOURCE_TARBALL:-}" ]; then
    cp -- "$DH_SOURCE_TARBALL" "$TMP/src.tgz"
  else
    curl -fsSL --retry 3 --retry-delay 3 --connect-timeout 20 --max-time 300 -o "$TMP/src.tgz" \
      "https://codeload.github.com/$REPO/tar.gz/$sha" || die "تعذّر تنزيل الإصدار ${sha:0:7} من GitHub"
  fi
  mkdir "$TMP/site"
  if ! tar -xzf "$TMP/src.tgz" -C "$TMP/site" --no-same-owner --no-same-permissions \
       --wildcards --strip-components=3 "*/$SUBDIR/*" 2>"$TMP/tar.log"; then
    if grep -q 'Not found in archive' "$TMP/tar.log"; then reject_release "$sha" "لا يحوي مجلد $SUBDIR"; fi
    die "تعذّر فك الإصدار ${sha:0:7}: $(tail -n 1 "$TMP/tar.log")"
  fi
  # ملفات ومجلدات عادية فقط
  find "$TMP/site" -mindepth 1 ! -type f ! -type d -delete
  for f in index.html admin/index.html sw.js manifest.webmanifest assets/js/app.js assets/js/admin.js \
           assets/js/core.js assets/js/search.js assets/js/config.js assets/css/app.css; do
    [ -s "$TMP/site/$f" ] || reject_release "$sha" "ملف ناقص ($f)"
  done
  grep -q '/assets/js/app.js' "$TMP/site/index.html" || reject_release "$sha" "الصفحة الرئيسية غير صالحة"
  bad=$(inline_scripts "$TMP/site") || bad="(تعذّر الفحص)"
  [ -z "$bad" ] || reject_release "$sha" "فيه سكربت مضمَّن تمنعه سياسة الأمان ($bad)"
  printf '%s\n' "$sha" > "$TMP/site/release.txt"
  find "$TMP/site" -type d -exec chmod 755 {} +
  find "$TMP/site" -type f -exec chmod 644 {} +
  mv -T "$TMP/site" "$dir"
  rm -rf -- "$TMP"; TMP=
}

# سجل الإصدارات المعروضة (الأحدث آخراً)، يرجع خلاله أمر previous خطوة خطوة
ensure_history() {
  [ -s "$BASE/history" ] && return 0
  local cur prev
  cur=$(current_sha) || return 0
  prev=$(cat "$BASE/previous" 2>/dev/null) || prev=
  {
    if is_sha "$prev" && [ "$prev" != "$cur" ] && [ -d "$BASE/releases/$prev" ]; then printf '%s\n' "$prev"; fi
    printf '%s\n' "$cur"
  } > "$BASE/history"
  rm -f -- "$BASE/previous"
}

# تبديل ذري للرابط current؛ record=1 يضع الإصدار في آخر السجل
activate() {
  local sha=$1 record=${2:-1} cur
  cur=$(current_sha) || cur=
  if [ "$cur" != "$sha" ]; then
    ln -sfn "releases/$sha" "$BASE/.current.new"
    mv -Tf "$BASE/.current.new" "$BASE/current"
  fi
  if [ "$record" = 1 ]; then
    { grep -vx -- "$sha" "$BASE/history" 2>/dev/null || true; printf '%s\n' "$sha"; } | tail -n 20 > "$BASE/history.new"
    mv -f -- "$BASE/history.new" "$BASE/history"
  fi
  return 0
}

# يُبقي الإصدار الحالي والمثبّت وآخر $KEEP إصدارات في السجل، ويحذف ما عداها
prune() {
  local keep cur d s
  cur=$(current_sha) || cur=
  keep=" $cur $(cat "$BASE/PINNED" 2>/dev/null || true) $(tail -n "$KEEP" "$BASE/history" 2>/dev/null | tr '\n' ' ') "
  for d in "$BASE"/releases/*/; do
    d=${d%/}; s=${d##*/}
    is_sha "$s" || continue
    case $keep in *" $s "*) continue ;; esac
    rm -rf -- "${BASE:?}/releases/$s"
  done
  return 0
}

fix_owner() {
  if [ "$(id -u)" -eq 0 ] && id "$SITE_USER" >/dev/null 2>&1; then
    chown -R "$SITE_USER:$SITE_USER" "$BASE"
  fi
}

# ─────────── Caddy ───────────

detect_caddy() {
  need_tools caddy systemctl
  systemctl is-active --quiet caddy || die "خدمة caddy لا تعمل على هذا السيرفر"
  local exec
  exec=$(systemctl show caddy -p ExecStart 2>/dev/null) || exec=
  [[ $exec == *--resume* ]] && die "Caddy يعمل بإعداد محفوظ عبر API (--resume)، فلا يمكن تعديله آلياً؛ لم يتغير شيء"
  if [ -z "$CADDYFILE" ]; then
    if [[ $exec =~ --config[[:space:]=]+([^[:space:]\;]+) ]]; then CADDYFILE=${BASH_REMATCH[1]}
    else CADDYFILE=/etc/caddy/Caddyfile; fi
  fi
  [ -f "$CADDYFILE" ] || die "لم أجد ملف إعداد Caddy: $CADDYFILE"
  case $CADDYFILE in *.json) die "إعداد Caddy بصيغة JSON غير مدعوم آلياً؛ لم يتغير شيء" ;; esac
}

caddy_validate() { caddy validate --config "$CADDYFILE" --adapter caddyfile >"$STATE/validate.log" 2>&1; }
caddy_adapt()    { caddy adapt --config "$CADDYFILE" --adapter caddyfile >"$1" 2>"$STATE/adapt.log"; }
caddy_reload()   { systemctl reload caddy >"$STATE/reload.log" 2>&1; }

# الإعداد الذي يعمل به Caddy الآن (من واجهة الإدارة المحلية)، لمقارنته بالملف على القرص
caddy_running() {
  local admin
  admin=$(python3 -c 'import json,sys
a = json.load(open(sys.argv[1])).get("admin") or {}
print("off" if a.get("disabled") else (a.get("listen") or "localhost:2019"))' "$1" 2>/dev/null) || return 1
  admin=${admin#tcp/}; admin=${admin%%|*}
  case $admin in
    off) return 1 ;;
    unix/*) curl -fsS --noproxy '*' --max-time 5 --unix-socket "${admin#unix/}" http://localhost/config/ >"$2" 2>/dev/null ;;
    :*) curl -fsS --noproxy '*' --max-time 5 "http://localhost$admin/config/" >"$2" 2>/dev/null ;;
    *) curl -fsS --noproxy '*' --max-time 5 "http://$admin/config/" >"$2" 2>/dev/null ;;
  esac
}

# مواقع (غير الدليل) يختلف إعدادها على القرص عمّا يعمل به Caddy؛ فارغ إن تطابقا أو تعذّر الفحص
pending_edits() {
  caddy_running "$STATE/adapt-before.json" "$STATE/running.json" || { echo "?"; return 0; }
  local r
  r=$(caddy_patch compare "$STATE/adapt-before.json" "$HOST" "$STATE/running.json" "$STATE")
  [ "$(json_get "$r" status)" = same ] || json_get "$r" hosts
}

# يحلل ملفات Caddy ويستبدل كتلة النطاق (أو يعيدها)؛ لا يكتب شيئاً في وضع analyze
caddy_patch() {
  python3 - "$@" "$MARKER" <<'PY'
import glob, json, os, re, sys

mode, caddyfile, host, site_conf, state, MARK = sys.argv[1:7]
host = host.lower()
IMPORT_LINE = 'import ' + site_conf

TARGETS = {host, 'www.' + host}

def fail(msg):
    print(json.dumps({'status': 'error', 'error': msg}, ensure_ascii=False))
    sys.exit(0)

def read_text(f):
    """النص دون علامة BOM (يتجاهلها Caddy)، مع تذكّر وجودها لإعادتها عند الكتابة"""
    t = open(f, encoding='utf-8', newline='').read()
    return (t[1:], True) if t.startswith('﻿') else (t, False)

def scan(text):
    """أحداث الأقواس خارج النصوص والتعليقات وheredoc: [(رقم السطر، القوس)]"""
    ev, i, n, line, start = [], 0, len(text), 0, True
    while i < n:
        c = text[i]
        if c == '\n':
            line += 1; start = True; i += 1; continue
        if c in ' \t\r':
            start = True; i += 1; continue
        if c == '#' and start:
            j = text.find('\n', i); i = n if j < 0 else j; continue
        # مثل Caddy: علامة الاقتباس تبدأ نصاً في أول الكلمة فقط
        if c == '"' and start:
            i += 1
            while i < n and text[i] != '"':
                if text[i] == '\\':
                    i += 1
                    if i < n and text[i] == '\n': line += 1
                elif text[i] == '\n': line += 1
                i += 1
            if i >= n: raise ValueError('quoted string without end')
            i += 1; start = False; continue
        if c == '`' and start:
            j = text.find('`', i + 1)
            if j < 0: raise ValueError('backtick string without end')
            line += text.count('\n', i, j); i = j + 1; start = False; continue
        if c == '<' and start and text.startswith('<<', i):
            m = re.match(r'<<([A-Za-z0-9_-]+)[ \t]*\r?\n', text[i:])
            if m:
                marker, j = m.group(1), i + m.end()
                line += 1
                # سطر الإغلاق يبدأ بالعلامة وقد تليه وسائط أخرى (مثل: HTML 200)
                end = re.compile(r'[ \t]*' + re.escape(marker) + r'(?=\s|$)')
                while True:
                    k = text.find('\n', j)
                    seg = text[j:n if k < 0 else k]
                    e = end.match(seg)
                    if e:
                        i = j + e.end(); break
                    if k < 0: raise ValueError('heredoc without end')
                    j = k + 1; line += 1
                start = False; continue
        if c in '{}':
            ev.append((line, c))
        start = False; i += 1
    return ev

def code_part(s):
    """السطر دون تعليقه"""
    out, q = [], False
    for k, ch in enumerate(s):
        if ch == '"' and (k == 0 or s[k - 1] != '\\'): q = not q
        if ch == '#' and not q and (k == 0 or s[k - 1] in ' \t'): break
        out.append(ch)
    return ''.join(out).rstrip()

def prev_code(codes, i):
    """أقرب سطر فيه كود قبل السطر i (تُتخطّى الأسطر الفارغة والتعليقات)"""
    j = i - 1
    while j >= 0 and codes[j] == '':
        j -= 1
    return j if j >= 0 else None

def blocks(text):
    lines = text.split('\n')
    codes = [code_part(l).strip() for l in lines]
    res, depth, cur = [], 0, None
    for ln, ch in scan(text):
        if ch == '{':
            if depth == 0: cur = ln
            depth += 1
        else:
            depth -= 1
            if depth < 0: raise ValueError('extra } at line %d' % (ln + 1))
            if depth == 0:
                if not codes[cur].endswith('{'): continue
                start, head = cur, codes[cur][:-1].strip()
                if head == '':
                    # «{» وحده في سطر: العنوان في السطر السابق (إلا كتلة الإعدادات العامة)
                    k = prev_code(codes, cur)
                    if k is not None and not codes[k].endswith(('{', '}')):
                        start, head = k, codes[k]
                # قائمة عناوين ممتدة على عدة أسطر تنتهي بفاصلة
                k = prev_code(codes, start)
                while head and k is not None and codes[k].endswith(','):
                    start, head = k, codes[k] + ' ' + head
                    k = prev_code(codes, start)
                res.append({'start': start, 'end': ln, 'head': head})
    if depth != 0: raise ValueError('unbalanced braces')
    return res, lines

def top_imports(text, lines, base_dir):
    inside = set()
    for b in blocks(text)[0]:
        inside.update(range(b['start'], b['end'] + 1))
    out = []
    for k, l in enumerate(lines):
        if k in inside: continue
        m = re.match(r'\s*import\s+(?:"([^"]+)"|`([^`]+)`|(\S+))', code_part(l))
        if m:
            p = m.group(1) or m.group(2) or m.group(3)
            if '/' in p or '*' in p or '.' in p:
                out.append(os.path.join(base_dir, p) if not os.path.isabs(p) else p)
    return out

def norm(addr):
    a = addr.strip().lower()
    scheme = ''
    m = re.match(r'^(https?)://', a)
    if m: scheme = m.group(1); a = a[m.end():]
    a = a.split('/')[0]
    a = re.sub(r':\d+$', '', a)
    return scheme, a

def files_to_scan():
    seen, order, todo = set(), [], [(caddyfile, 0)]
    while todo:
        f, d = todo.pop(0)
        f = os.path.realpath(f)
        if f in seen or d > 3 or not os.path.isfile(f): continue
        seen.add(f); order.append(f)
        text = read_text(f)[0]
        b, lines = blocks(text)
        for pat in top_imports(text, lines, os.path.dirname(f)):
            for g in sorted(glob.glob(pat)):
                todo.append((g, d + 1))
    return order

def analyze():
    found, already = [], []
    for f in files_to_scan():
        text = read_text(f)[0]
        try:
            bl, lines = blocks(text)
        except ValueError as e:
            fail('تعذّر فهم %s: %s' % (f, e))
        if any(code_part(l).strip() == IMPORT_LINE for l in lines):
            already.append(f)
        for b in bl:
            if not b['head'] or b['head'].startswith('('): continue
            if '{' in b['head'] or '}' in b['head']:
                # عنوان فيه متغيّر مثل {$N8N_HOST}: لا يخصّنا إلا إن ذُكر نطاقنا فيه
                if host in b['head'].lower():
                    fail('سطر عنوان غير مألوف في %s سطر %d' % (f, b['start'] + 1))
                continue
            addrs = [a for a in re.split(r'[,\s]+', b['head']) if a]
            parsed = [norm(a) for a in addrs]
            if not any(h == host and s != 'http' for s, h in parsed): continue
            others = [a for (s, h), a in zip(parsed, addrs) if h not in (host, 'www.' + host)]
            if others:
                fail('كتلة %s في %s مشتركة مع عناوين أخرى (%s)؛ عدّلها يدوياً' % (host, f, ', '.join(others)))
            tail = code_part(lines[b['end']]).strip()
            if tail != '}':
                fail('نهاية كتلة %s في %s سطر %d غير مألوفة' % (host, f, b['end'] + 1))
            found.append({'file': f, 'start': b['start'], 'end': b['end'], 'addresses': ', '.join(addrs)})
    if already:
        return {'status': 'already', 'file': already[0], 'others': found}
    if not found:
        fail('لم أجد كتلة %s في إعداد Caddy (%s)' % (host, caddyfile))
    if len(found) > 1:
        fail('وجدت أكثر من كتلة لـ %s: %s' % (host, ', '.join('%s:%d' % (x['file'], x['start'] + 1) for x in found)))
    return dict(found[0], status='patch')

def write_like(path, text, bom=False):
    st = os.stat(path)
    tmp = path + '.dalil-hama-site.tmp'
    with open(tmp, 'w', encoding='utf-8', newline='') as fh:
        fh.write(('﻿' if bom else '') + text)
    os.chmod(tmp, st.st_mode & 0o7777)
    try: os.chown(tmp, st.st_uid, st.st_gid)
    except PermissionError: pass
    os.replace(tmp, path)

def main():
    if mode == 'analyze':
        print(json.dumps(analyze(), ensure_ascii=False))
    elif mode == 'apply':
        r = analyze()
        if r['status'] != 'patch':
            print(json.dumps(r, ensure_ascii=False)); return
        text, bom = read_text(r['file'])
        lines = text.split('\n')
        old = '\n'.join(lines[r['start']:r['end'] + 1]) + '\n'
        indent = re.match(r'[ \t]*', lines[r['start']]).group(0)
        eol = '\r' if lines[r['start']].endswith('\r') else ''
        new = lines[:r['start']] + [indent + MARK + eol, indent + IMPORT_LINE + eol] + lines[r['end'] + 1:]
        with open(os.path.join(state, 'old-block.caddy'), 'w', encoding='utf-8', newline='') as fh:
            fh.write(old)
        with open(os.path.join(state, 'patched-file'), 'w', encoding='utf-8', newline='') as fh:
            fh.write(r['file'] + '\n')
        write_like(r['file'], '\n'.join(new), bom)
        print(json.dumps(dict(r, status='patched'), ensure_ascii=False))
    elif mode == 'unpatch':
        try:
            f = open(os.path.join(state, 'patched-file'), encoding='utf-8', newline='').read().strip()
            old = open(os.path.join(state, 'old-block.caddy'), encoding='utf-8', newline='').read()
        except OSError:
            fail('لا توجد نسخة محفوظة من كتلة الموقع القديم')
        text, bom = read_text(f)
        lines = text.split('\n')
        idx = [k for k, l in enumerate(lines) if code_part(l).strip() == IMPORT_LINE]
        if not idx and old.rstrip('\n') in text:
            # أُعيدت الكتلة القديمة من قبل (رجوع سابق أو انقطع قبل إعادة التحميل)
            print(json.dumps({'status': 'unpatched', 'file': f, 'already': True}, ensure_ascii=False))
            return
        if len(idx) != 1:
            fail('لم أجد سطر الموقع الجديد في %s' % f)
        k = idx[0]
        a = k - 1 if k > 0 and lines[k - 1].strip() == MARK else k
        new = lines[:a] + old.rstrip('\n').split('\n') + lines[k + 1:]
        write_like(f, '\n'.join(new), bom)
        print(json.dumps({'status': 'unpatched', 'file': f}, ensure_ascii=False))
    elif mode == 'compare':
        # حارس أخير: الإعداد كما يفهمه Caddy نفسه قبل التعديل وبعده (caddy adapt)
        # يجب أن يبقى متطابقاً لكل المواقع عدا نطاقنا
        before = routes_of(json.load(open(caddyfile, encoding='utf-8')))
        after = routes_of(json.load(open(site_conf, encoding='utf-8')))
        if before != after:
            hosts = ', '.join(sorted({h for r in set(before) ^ set(after) for h in json.loads(r)[1]}) or ['(بلا نطاق)'])
            print(json.dumps({'status': 'error', 'hosts': hosts,
                              'error': 'التعديل كان سيغيّر مواقع أخرى في Caddy: %s' % hosts}, ensure_ascii=False))
            return
        print(json.dumps({'status': 'same'}))

def routes_of(cfg):
    """مسارات كل الخوادم عدا التي تخص نطاقنا وحده، بصيغة قابلة للمقارنة"""
    out = []
    servers = (((cfg or {}).get('apps') or {}).get('http') or {}).get('servers') or {}
    for srv in servers.values():
        listen = sorted(srv.get('listen') or [])
        groups = (('routes', srv.get('routes') or []), ('errors', (srv.get('errors') or {}).get('routes') or []))
        for kind, rs in groups:
            for r in rs:
                hosts = set()
                for m in r.get('match') or []:
                    hosts.update(h.lower() for h in (m.get('host') or []))
                if hosts and hosts <= TARGETS: continue
                out.append(json.dumps([listen, sorted(hosts), kind, r], sort_keys=True, ensure_ascii=False))
    return sorted(out)

try:
    main()
except (ValueError, OSError, UnicodeDecodeError) as e:
    fail('تعذّر قراءة إعداد Caddy: %s' % e)
PY
}

json_get() { python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2],""))' "$1" "$2"; }

write_site_conf() {
  local addresses=$1 tmp=$SITE_CONF.new
  mkdir -p "$ETC"; chmod 755 "$ETC"
  cat > "$tmp" <<EOF
# دليل حماة — الموقع الجديد (ملفات ثابتة من $BASE/current).
# يكتب هذا الملفَّ الأمرُ dalil-hama-site عند كل تثبيت؛ أي تعديل يدوي هنا يُستبدل.
$addresses {
	root * $BASE/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(self), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://cdnjs.cloudflare.com; font-src 'self'; connect-src 'self' https://jhgwzynxkioqfyoldoyx.supabase.co; manifest-src 'self'; worker-src 'self'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}

	@revalidate path / /index.html /admin/ /admin/index.html /privacy/ /privacy/index.html /sw.js /manifest.webmanifest /release.txt /robots.txt /sitemap.xml *.js *.css
	header @revalidate Cache-Control "no-cache"
	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path /assets/img/* /favicon.svg
	header @images Cache-Control "public, max-age=86400"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	redir /admin /admin/ 308
	redir /privacy /privacy/ 301
	respond /health "ok" 200

	file_server

	handle_errors {
		@missing_page {
			expression {err.status_code} == 404
			path_regexp ^/[^.]*$
		}
		redir @missing_page / 302
		respond "{err.status_code} {err.status_text}"
	}
}
EOF
  chmod 644 "$tmp"
