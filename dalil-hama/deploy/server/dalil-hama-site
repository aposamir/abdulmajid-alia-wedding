    inactive) echo "متوقف" ;;
    failed) echo "متعطّل" ;;
    activating|reloading) echo "يبدأ" ;;
    '') echo "غير معروف" ;;
    *) echo "$st" ;;
  esac
}

cmd_status() {
  load_conf
  local cur served remote note=
